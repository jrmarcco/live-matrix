{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["electron/**/*", "src/shared/**/*"],
  "exclude": ["electron/**/*.test.ts", "src/shared/**/*.test.ts"]
}
