{
  "name": "live-matrix",
  "version": "1.4.0",
  "description": "LiveMatrix — 同屏多开观看不同直播（哔哩哔哩 / 抖音），单主窗口多副窗口，仅主窗口有声",
  "main": "dist/electron/main.js",
  "author": "LiveMatrix",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepare": "husky",
    "build": "node scripts/build.mjs",
    "start": "pnpm run build && node scripts/electron-run.mjs .",
    "dev": "tsc -p tsconfig.electron.json && concurrently -k -n vite,electron -c blue,green \"vite\" \"cross-env LM_DEV=1 node scripts/electron-run.mjs .\"",
    "smoke": "pnpm run build && node scripts/electron-run.mjs . --lm-smoke",
    "sync-electron": "node scripts/sync-electron-dist.mjs",
    "icons": "node scripts/make-icons.mjs",
    "icons:embed": "node scripts/embed-icons.mjs",
    "dist:win": "pnpm run build && electron-builder --win --publish never",
    "dist:mac": "pnpm run build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "mpegts.js": "^1.8.2"
  }
}
